# Copy this file to .env on the VPS (cp env.example .env) and change every value.
# .env stays on the VPS only. Never put it in GitHub.

# Database password: any long random text, e.g. from: openssl rand -hex 24
DB_PASSWORD=change-me

# Your login for https://list.chaiweekly.co.ke/admin (created on first start)
ADMIN_USER=maxwell
ADMIN_PASSWORD=change-me-too

# The Docker network of the Caddy already running on the VPS (SETUP.md step 3 shows how to find it)
PROXY_NETWORK=change-me
