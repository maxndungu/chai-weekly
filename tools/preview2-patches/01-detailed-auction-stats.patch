diff --git a/_includes/data-signup.html b/_includes/data-signup.html
new file mode 100644
index 0000000..694a042
--- /dev/null
+++ b/_includes/data-signup.html
@@ -0,0 +1,55 @@
+{%- comment -%}
+Detailed auction statistics, open free to readers who sign up (name, email, company, role) until
+site.data_free_until. The form posts to the sign-up helper on the VPS (deploy/datasignup), which adds the
+reader to the "Auction data" list in listmonk and sends them back here with ?signup=ok.
+Usage: {% capture detail %}...the detailed tables...{% endcapture %}{% include data-signup.html detail=detail %}
+{%- endcomment -%}
+<section class="data-gate" id="detailed">
+  <h2 class="label rule">Detailed statistics</h2>
+  <div class="data-locked">
+    <p class="data-pitch"><strong>Free to read until {{ site.data_free_until | date: "%-d %B %Y" }}.</strong>
+      Tell us who you are and the detailed figures open straight away. Readers who sign up now keep a founding-member
+      price when the detail becomes a paid service. The weekly averages on this page stay free for everyone.</p>
+    <p class="data-msg" hidden data-for="bad">Please fill in your name, a working email address and your company.</p>
+    <p class="data-msg" hidden data-for="error">Something went wrong on our side. Please try again in a few minutes.</p>
+    <form class="data-form" action="{{ site.data_signup_url }}" method="post">
+      <input type="hidden" name="next" value="{{ page.url | absolute_url }}">
+      <label>Your name<input name="name" autocomplete="name" required maxlength="120"></label>
+      <label>Email<input type="email" name="email" autocomplete="email" required maxlength="200"></label>
+      <label>Company or organisation<input name="company" autocomplete="organization" required maxlength="160"></label>
+      <label>What you do in tea
+        <select name="role">
+          <option value="grower">Grow tea</option>
+          <option value="factory">Run or work at a factory</option>
+          <option value="broker">Broker</option>
+          <option value="buyer">Buy, blend or pack</option>
+          <option value="warehouse">Warehouse or logistics</option>
+          <option value="researcher">Research, finance or government</option>
+          <option value="other" selected>Something else</option>
+        </select>
+      </label>
+      <label class="data-check"><input type="checkbox" name="newsletter" value="1" checked> Also send me Chai Weekly, free every Wednesday</label>
+      <input type="text" name="nonce" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none">
+      <button type="submit">Open the detailed statistics</button>
+      <p class="fine">We'll email you once to confirm your address. We never share your details.</p>
+    </form>
+  </div>
+  <div class="data-open" hidden>
+    <p class="data-msg" hidden data-for="ok">Thank you. The detailed figures are open on this device. Please click the link in the email we just sent to confirm your address.</p>
+    {{ include.detail }}
+  </div>
+</section>
+<script>
+(function () {
+  var box = document.getElementById("detailed"), key = "chai-data-access", q = new URLSearchParams(location.search), r = q.get("signup");
+  function store(v) { try { if (v) localStorage.setItem(key, v); return localStorage.getItem(key); } catch (e) { return null; } }
+  var open = store(r === "ok" ? "1" : null) === "1" || r === "ok";
+  box.querySelector(".data-locked").hidden = open;
+  box.querySelector(".data-open").hidden = !open;
+  if (r) {
+    var m = box.querySelector('.data-msg[data-for="' + r + '"]');
+    if (m) { m.hidden = false; box.scrollIntoView(); }
+    history.replaceState(null, "", location.pathname + "#detailed");
+  }
+})();
+</script>
