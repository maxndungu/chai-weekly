+      var vals = Object.keys(s[1]).map(function (y) { return s[1][y]; });
+      if (!vals.length) { $(s[0]).innerHTML = "<p class='muted'>No figures.</p>"; return; }
+      var c = chart($(s[0]), W, 260, { l: 44, r: 12, t: 12, b: 30 }, [y0, y1], Math.max.apply(0, vals), fmtT);
+      years(c, y0, y1, y1 - y0 > 40 ? 20 : 10);
+      var ys = series(c, s[1], s[2], function (y, v) { return name + ", " + y + ": " + num(v) + s[3]; });
